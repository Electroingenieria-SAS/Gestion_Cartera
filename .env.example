# =========================================================
# Variables de entorno. Se configuran en Vercel
# (Settings -> Environment Variables), NUNCA dentro del código.
# =========================================================

# --- Supabase (Fase 2) ---
# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publica

# --- Correos de alertas (Fase 6B) ---
# La clave secreta de Supabase: Project Settings -> API -> service_role (SECRET)
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_secreta
# La clave de Resend: resend.com -> API Keys
RESEND_API_KEY=tu_clave_de_resend
# El correo donde quieres recibir las alertas (en modo prueba: el mismo de tu cuenta Resend)
CORREO_ALERTAS=tucorreo@ejemplo.com
